# Copy this file to .env and fill in real values as you connect integrations.
# Everything is optional at first - adapters degrade gracefully (health_check
# reports "not configured") rather than failing the whole app.

ENVIRONMENT=development

# Postgres (used automatically inside docker-compose; leave unset to fall
# back to a local SQLite file for running the backend outside Docker)
DATABASE_URL=postgresql://aieop:aieop@postgres:5432/aieop

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# GitHub - personal access token with repo read (and issues:write if you
# want the Developer/Incident agents to create issues)
GITHUB_TOKEN=

# Taiga
TAIGA_BASE_URL=
TAIGA_USERNAME=
TAIGA_PASSWORD=

# Discord bot token (Bot permissions: Send Messages, Read Message History)
DISCORD_BOT_TOKEN=
