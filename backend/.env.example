# Copy this file to .env and fill in real values.
# The platform is GitHub-only by product decision - see README for why.

ENVIRONMENT=development

# Postgres (used automatically inside docker-compose; leave unset to fall
# back to a local SQLite file for running the backend outside Docker)
DATABASE_URL=postgresql://aieop:aieop@postgres:5432/aieop

REDIS_URL=redis://redis:6379/0

JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=720

# GitHub - personal access token with repo read (and issues:write if you
# want the Developer/Incident agents to create issues, workflow:write if
# you want trigger_ci to work). This is the platform's only external
# integration - see POST /api/github/sync.
GITHUB_TOKEN=

# LLM - optional but recommended. Without a key, RAG answers fall back to
# extractive excerpts and incident root-cause explanations fall back to a
# plain template - the platform is fully functional either way, just less
# fluent. Provider-agnostic: pick one, no code changes needed.
#
# Gemini (default) - free tier, get a key at https://aistudio.google.com/apikey
LLM_PROVIDER=gemini
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash
#
# To use Anthropic instead:
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# LLM_MODEL=claude-sonnet-5
